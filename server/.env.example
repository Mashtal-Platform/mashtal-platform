# Mongo
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=5000

# Stripe (cart + business subscription)
# Dashboard → Developers → API keys (Test mode): Secret key
STRIPE_SECRET_KEY=sk_test_...
# From `npm run stripe:listen` (or Stripe Dashboard webhook → Signing secret)
# Keep the listen process running while testing payments locally
STRIPE_WEBHOOK_SECRET=whsec_...

# Random password YOU invent (not from Stripe/Wish). Used to verify Wish callbacks.
WISH_MONEY_WEBHOOK_SECRET=

# Business signup fee (USD) and cart tax rate
BUSINESS_FEE_USD=499
# Paid business access length before renewal is required
BUSINESS_SUBSCRIPTION_DAYS=60
TAX_RATE=0.15
PAYMENT_CURRENCY=usd

# First admin bootstrap (`npm run create-admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong
ADMIN_FULL_NAME=Mashtal Admin
