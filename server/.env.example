# Mongo
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=5000

# Stripe (cart + business subscription)
# Dashboard → Developers → API keys (Test mode): Secret key
STRIPE_SECRET_KEY=sk_test_...
# From `npm run stripe:listen` (or Stripe Dashboard webhook → Signing secret)
# Keep the listen process running while testing payments locally
STRIPE_WEBHOOK_SECRET=whsec_...

# Random password YOU invent (not from Stripe/Wish). Used to verify Wish callbacks.
WISH_MONEY_WEBHOOK_SECRET=

# Business signup fee (USD) and cart tax rate
BUSINESS_FEE_USD=499
# Paid business access length before renewal is required
BUSINESS_SUBSCRIPTION_DAYS=60
TAX_RATE=0.15
PAYMENT_CURRENCY=usd

# Email verification (SMTP). When set, verification links are emailed to the
# user instead of printed to the server console.
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=Mashtal <your.email@gmail.com>
# Where the verification link points (your running client)
FRONTEND_URL=http://localhost:3000

# First admin bootstrap (`npm run create-admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong
ADMIN_FULL_NAME=Mashtal Admin
