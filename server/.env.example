# Mongo
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=5000

# Stripe (cart + business subscription)
# Dashboard → Developers → API keys (Test mode): Secret key
STRIPE_SECRET_KEY=sk_test_...
# From `npm run stripe:listen` (or Stripe Dashboard webhook → Signing secret)
# Keep the listen process running while testing payments locally
STRIPE_WEBHOOK_SECRET=whsec_...

# Random password YOU invent (not from Stripe/Wish). Used to verify Wish callbacks.
WISH_MONEY_WEBHOOK_SECRET=

# Business signup fee (USD) and cart tax rate
BUSINESS_FEE_USD=499
# Paid business access length before renewal is required
BUSINESS_SUBSCRIPTION_DAYS=60
TAX_RATE=0.15
PAYMENT_CURRENCY=usd

# Email verification (SMTP). When set, verification links are emailed to the
# user instead of printed to the server console.
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=Mashtal <your.email@gmail.com>
# Where the verification link points (your running client)
FRONTEND_URL=http://localhost:3000

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
# Use the same client ID in client/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# "See translation" — free MyMemory by default (no API key / no Azure)
# TRANSLATE_PROVIDER=mymemory | libretranslate
TRANSLATE_PROVIDER=mymemory
# Optional: raise MyMemory free daily limit (https://mymemory.translated.net/doc/spec.php)
# MYMEMORY_EMAIL=you@example.com
# Later (self-hosted LibreTranslate): TRANSLATE_PROVIDER=libretranslate
# LIBRETRANSLATE_URL=http://127.0.0.1:5001
# LIBRETRANSLATE_API_KEY=

# First admin bootstrap (`npm run create-admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong
ADMIN_FULL_NAME=Mashtal Admin

# Content moderation (local models via @xenova/transformers — free, no API key)
# Downloads Xenova/toxic-bert + CLIP once into server/.cache/transformers
MODERATION_ENABLED=true
MODERATION_TOXICITY_THRESHOLD=0.85
MODERATION_NSFW_THRESHOLD=0.25
MODERATION_WEAPON_IMAGE_THRESHOLD=0.25
# Set true only for local dev if models fail to load and you still want to post
# MODERATION_FAIL_OPEN=true

# Local plant-disease image classifier (Python sidecar — free, no image API)
# Install once: pip install -r ai-disease/requirements.txt
# Then npm run dev starts predict_server.py on port 8765 automatically
LOCAL_DISEASE_URL=http://127.0.0.1:8765
LOCAL_DISEASE_PORT=8765
# LOCAL_DISEASE_AUTOSTART=false
# LOCAL_DISEASE_PYTHON=python
# Treatment / chat text still uses Hugging Face (set HF_API_TOKEN)
# HF_API_TOKEN=hf_...
