# API
VITE_API_URL=http://localhost:5000/api

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
# Safe to expose in the browser; must match server GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Stripe publishable key (Dashboard → Developers → API keys)
# Safe to expose in the browser — never put sk_ or whsec_ here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Shown on business payment UI (keep in sync with server BUSINESS_FEE_USD)
VITE_BUSINESS_FEE_USD=499
